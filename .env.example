# Standalone Express API listener
PORT=4000
NODE_ENV=development

# Browser client origin(s), comma-separated. For local Vite use http://localhost:5173.
ALLOWED_ORIGINS=http://localhost:5173

# Persistence/auth. Leave MONGODB_URI empty only for temporary seeded demo data.
DEMO_MODE=true
MONGODB_URI=
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_EMAILS=admin@skillhub.local
